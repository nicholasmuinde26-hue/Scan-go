# Server Port
PORT=5000

# Environment Mode
TRUST_PROXY_HOPS=1
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/scan_and_go_db

# Security & Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
HMAC_RECEIPT_SECRET=your_hmac_receipt_signature_secret_here

# Safaricom Daraja M-PESA Configuration
MPESA_ENVIRONMENT=sandbox
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_daraja_passkey_here
MPESA_CONSUMER_KEY=your_daraja_consumer_key_here
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret_here
MPESA_CALLBACK_SECRET=your_daraja_callback_secret_token_here
MPESA_CALLBACK_URL=http://localhost:5000/api/v1/payments/mpesa/callback?secret=your_daraja_callback_secret_token_here
FRONTEND_URL=http://localhost:5173
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret_here
# Set true only on isolated local development systems. Production never mounts payment simulation.
ENABLE_PAYMENT_SIMULATION=false

# AI exit-verification sidecar (ai-service/ FastAPI). Leave empty to disable.
AI_SERVICE_URL=http://localhost:8090
AI_SERVICE_TIMEOUT_MS=2500
AI_SERVICE_API_KEY=

# PostgreSQL financial ledger (optional). When set, orders/payments are
# mirrored into relational tables for reconciliation. MongoDB stays authoritative.
POSTGRES_URL=
