{
  "expo": {
    "name": "Scan & Go",
    "slug": "mobile-scan-and-go",
    "scheme": "scanandgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan product barcodes and store entry posters."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Confirm your presence at a participating store."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.nickiied.mobilescanandgo"
    }
  }
}
